{"1":{"t":"어머니가 가시는 곳에","sp":{"8":[[1,"나오미","두 며느리","speech",""]],"10":[[1,"두 며느리","나오미","speech",""]],"11":[[1,"나오미","두 며느리","speech",""]],"15":[[1,"나오미","룻","speech",""]],"16":[[1,"룻","나오미","speech",""]],"19":[[3,"베들레헴 여자들","","speech",""]],"20":[[1,"나오미","베들레헴 여자들","speech",""]]},"ln":{"1":[["bg-people-034","유다","person"],["bg-places-044","베들레헴","place"],["bg-places-025","모압","place"]],"2":[["bg-people-105","엘리멜렉","person"],["bg-people-104","나오미","person"],["bg-people-108","말론","person"],["bg-people-109","기룐","person"],["bg-people-034","유다","person"],["bg-places-044","베들레헴","place"],["bg-places-045","에브랏","place"],["bg-places-025","모압","place"]],"3":[["bg-people-104","나오미","person"],["bg-people-105","엘리멜렉","person"]],"4":[["bg-places-025","모압","place"],["bg-people-107","오르바","person"],["bg-people-106","룻","person"]],"5":[["bg-people-108","말론","person"],["bg-people-109","기룐","person"]],"6":[["bg-people-104","나오미","person"],["bg-places-025","모압","place"]],"7":[["bg-people-104","나오미","person"],["bg-people-034","유다","person"]],"8":[["bg-people-104","나오미","person"],["ruth-hesed","한결같은 사랑","hebrew"]],"9":[["bg-people-104","나오미","person"]],"11":[["bg-people-104","나오미","person"]],"14":[["bg-people-107","오르바","person"],["bg-people-106","룻","person"],["ruth-cling","꼭 붙어 있었다","hebrew"]],"15":[["bg-people-104","나오미","person"]],"16":[["bg-people-106","룻","person"]],"18":[["bg-people-104","나오미","person"],["bg-people-106","룻","person"]],"19":[["bg-places-044","베들레헴","place"],["bg-people-104","나오미","person"]],"20":[["bg-people-104","나오미","person"]],"21":[["ruth-empty","빈손","hebrew"],["bg-people-104","나오미","person"]],"22":[["bg-people-104","나오미","person"],["bg-places-025","모압","place"],["bg-people-106","룻","person"],["bg-places-044","베들레헴","place"]]},"vn":{"8":[{"he":"חֶסֶד","rd":"헤세드","m":"곁을 지키는 신실한 사랑","t":"단순한 호감보다 관계 안에서 끝까지 책임지는 사랑을 가리켜요. 나오미는 오르바와 룻이 이미 남편들과 자신에게 그런 사랑을 베풀었다고 인정해요. 룻만 사랑했고 오르바는 배신했다는 식으로 앞부분을 지워서 읽으면 안 돼요."}],"13":[{"he":"מַר־לִי מְאֹד מִכֶּם","rd":"마르 리 메오드 미켐","m":"내게 몹시 쓰라리다","t":"마지막 표현 ‘미켐’은 ‘너희 때문에·너희를 생각하면’ 또는 ‘너희보다 더’로 해석돼요. 며느리들의 처지를 염려하는 문맥이라 앞의 뜻으로 읽을 수 있어요. 누가 더 고통스러운지 순서를 매기는 말로 단정하지는 않아요."}],"14":[{"he":"דָּבְקָה","rd":"다브카","m":"꼭 붙었다·떠나지 않았다","t":"창세기 2:24에서 남자가 아내와 연합한다고 할 때도 쓰는 동사 계열이에요. 여기서는 룻이 시어머니와의 관계를 포기하지 않는 행동을 말해요. 단어가 같아도 이 관계가 부부 관계라는 뜻은 아니에요."}],"17":[{"he":"כִּי הַמָּוֶת יַפְרִיד","rd":"키 함마벳 야프리드","m":"죽음이 갈라놓을 것","t":"엄숙한 맹세 문형이에요. ‘죽음 외의 것이 우리를 갈라놓는다면’ 또는 ‘죽음조차 갈라놓는다면’ 등으로 옮기는 견해가 있어요. 죽음까지 함께하겠다는 맹세의 문맥을 살려 앞의 뜻으로 읽을 수 있어요."}],"20":[{"he":"שַׁדַּי","rd":"샤다이","m":"전통적으로 전능하신 분","t":"하나님을 가리키는 호칭이에요. 전통 번역은 ‘전능자’이지만 어원 자체는 확정되지 않았어요. 나오미가 하나님께 버림받았다고 느끼며 하는 탄식이지, 저자가 그 가족의 죽음 원인을 판정한 문장과 곧바로 같지는 않아요."}],"21":[{"he":"עָנָה בִי","rd":"아나 비","m":"나를 거슬러 증언하셨다·나를 치셨다","t":"이 표현은 법정의 증언처럼 ‘나를 거슬러 증언했다’고도 옮기고, 고통을 겪게 했다는 뜻으로 ‘나를 대적했다·나를 쳤다’고도 읽어요. 룻이 곁에 있는데도 빈손이라고 말하는 것은 상실의 크기를 드러내는 탄식이에요."}]}},"2":{"t":"그 밭이 보아스의 밭이었다","sp":{"2":[[1,"룻","나오미","speech",""],[4,"나오미","룻","speech",""]],"4":[[2,"보아스","일꾼들","speech",""],[4,"일꾼들","보아스","speech",""]],"5":[[1,"보아스","일꾼들의 책임자","speech",""]],"6":[[1,"일꾼들의 책임자","보아스","speech",""]],"8":[[1,"보아스","룻","speech",""]],"10":[[1,"룻","보아스","speech",""]],"11":[[1,"보아스","룻","speech",""]],"13":[[1,"룻","보아스","speech",""]],"14":[[1,"보아스","룻","speech",""]],"15":[[1,"보아스","일꾼들","speech",""]],"19":[[1,"나오미","룻","speech",""]],"20":[[1,"나오미","룻","speech",""]],"21":[[1,"룻","나오미","speech",""]],"22":[[1,"나오미","룻","speech",""]]},"ln":{"1":[["bg-people-104","나오미","person"],["bg-people-105","엘리멜렉","person"]],"2":[["bg-places-025","모압","place"],["bg-people-106","룻","person"],["bg-people-104","나오미","person"]],"3":[["bg-people-106","룻","person"],["bg-things-058","이삭을 주웠","culture"],["ruth-chance","우연히","hebrew"],["bg-people-105","엘리멜렉","person"],["bg-people-110","보아스","person"]],"4":[["bg-people-110","보아스","person"],["bg-places-044","베들레헴","place"]],"5":[["bg-people-110","보아스","person"]],"6":[["bg-people-104","나오미","person"],["bg-places-025","모압","place"]],"8":[["bg-people-110","보아스","person"],["bg-people-106","룻","person"],["bg-people-104","마라","person"]],"10":[["bg-people-106","룻","person"]],"11":[["bg-people-110","보아스","person"]],"12":[["ruth-wings","날개 아래","hebrew"],["bg-people-025","이스라엘","person"]],"13":[["bg-people-106","룻","person"]],"14":[["bg-people-110","보아스","person"],["bg-people-106","룻","person"]],"15":[["bg-people-106","룻","person"],["bg-people-110","보아스","person"],["bg-people-104","마라","person"]],"16":[["bg-people-104","마라","person"]],"17":[["bg-people-106","룻","person"],["bg-things-058","이삭을 주웠","culture"],["bg-things-012","에바","culture"]],"18":[["bg-people-106","룻","person"]],"19":[["bg-people-106","룻","person"]],"20":[["bg-people-104","나오미","person"]],"21":[["bg-places-025","모압","place"],["bg-people-106","룻","person"]],"22":[["bg-people-104","나오미","person"],["bg-people-106","룻","person"]],"23":[["bg-people-106","룻","person"],["bg-people-110","보아스","person"],["bg-things-058","이삭을 주웠","culture"]]},"vn":{"1":[{"he":"גִּבּוֹר חַיִל","rd":"기보르 하일","m":"힘과 지위를 갖춘 사람","t":"전쟁 문맥에서는 ‘용사’를 뜻할 수 있지만, 여기서는 밭과 일꾼을 두고 성읍에서 영향력을 가진 보아스의 형편을 말해요. 3:11에서 룻에게도 같은 ‘하일’이 쓰여서, 재산 없는 룻도 힘과 가치 있는 사람으로 인정받아요."}],"3":[{"he":"וַיִּקֶר מִקְרֶהָ","rd":"바이케르 미크레하","m":"우연히 이른 그곳이","t":"‘우연히 일어남’을 겹쳐 표현한 말이에요. 룻은 밭 주인을 알고 계획해서 찾아간 것이 아니에요. ‘섭리’는 이 단어의 사전 뜻이 아니라, 사건이 엮여 가는 이야기 전체에서 읽어 내는 신학적 통찰이에요."}],"7":[{"he":"זֶה שִׁבְתָּהּ הַבַּיִת מְעָֽט","rd":"제 쉬브타 합바이트 메아트","m":"잠깐 쉰 것 외에는","t":"‘집에 머문 시간이 조금’이라는 끝부분은 문법과 장면이 난해해서 번역이 갈려요. ‘짧게 쉰 때를 빼고는 계속 일했다’는 전통적인 이해로 읽을 수 있어요. ‘집에서 잠깐 쉰 것’이 오늘날 같은 휴게 공간이 있었다는 뜻은 아니에요."}],"12":[{"he":"כְּנָפָֽיו","rd":"케나파브","m":"그분의 날개들","t":"날개는 새가 새끼를 덮듯 보호하는 모습의 비유예요. 3:9에서 룻이 보아스에게 옷자락을 펴 달라고 할 때 같은 ‘카나프’ 계열의 말이 나와요. 그래서 보아스는 자기가 빌어 준 보호의 기도가 자기 행동으로 이어질 기회를 만나는 셈이에요."}],"14":[{"he":"חֹמֶץ","rd":"호메츠","m":"식초·신 포도주","t":"포도주가 시어진 액체에 빵을 찍어 먹는 소박한 식사를 떠올리면 돼요. 오늘날의 독한 식초를 그대로 들이켜는 모습은 아니에요. 룻은 일꾼들 곁에 앉아 배불리 먹고, 남은 음식은 시어머니에게 가져가요."}],"20":[{"he":"חַסְדּוֹ","rd":"하스도","m":"그의 신실한 사랑","t":"‘사랑을 거두지 않은’ 이가 하나님인지 보아스인지 문법상 해석이 갈려요. 여호와께 대한 고백으로 읽을 수 있지만, 보아스의 행동을 가리킨다는 견해도 가능해요. 어느 쪽이든 하나님의 돌보심과 사람의 구체적인 사랑이 이 이야기 안에서 이어져요."}]}},"3":{"t":"옷자락을 펴 주세요","sp":{"1":[[1,"나오미","룻","speech",""]],"5":[[1,"룻","나오미","speech",""]],"9":[[1,"보아스","룻","speech",""],[2,"룻","보아스","speech",""]],"10":[[1,"보아스","룻","speech",""]],"14":[[2,"보아스","","speech",""]],"15":[[1,"보아스","룻","speech",""]],"16":[[1,"나오미","룻","speech",""]],"17":[[0,"룻","나오미","speech",""]],"18":[[1,"나오미","룻","speech",""]]},"ln":{"1":[["bg-people-104","나오미","person"],["bg-people-106","룻","person"]],"2":[["bg-people-110","보아스","person"],["bg-things-059","타작마당","culture"]],"3":[["bg-things-059","타작마당","culture"],["bg-people-104","마라","person"]],"5":[["bg-people-106","룻","person"]],"6":[["bg-people-106","룻","person"],["bg-things-059","타작마당","culture"]],"7":[["bg-people-110","보아스","person"],["bg-people-106","룻","person"]],"9":[["bg-people-110","보아스","person"],["bg-people-106","룻","person"],["ruth-wings","옷자락","hebrew"]],"10":[["bg-people-110","보아스","person"]],"11":[["bg-people-104","마라","person"]],"14":[["bg-people-106","룻","person"],["bg-people-110","보아스","person"],["bg-things-059","타작마당","culture"]],"15":[["bg-people-110","보아스","person"],["bg-people-106","룻","person"]],"16":[["bg-people-106","룻","person"]],"17":[["ruth-empty","빈손","hebrew"]]},"vn":{"4":[{"he":"מַרְגְּלֹתָיו","rd":"마르겔로타브","m":"그의 발치","t":"원문은 ‘그의 발 있는 쪽’, 곧 발치를 드러내라는 말이에요. 밤의 장면에 긴장은 있지만 본문이 성관계를 명시한다고 단정할 수는 없어요. 룻은 3:9에서 자기 요청을 분명히 말해요."}],"9":[{"he":"כְנָפֶךָ","rd":"케나페카","m":"당신의 날개·옷자락","t":"카나프는 새의 날개도 옷의 끝자락도 뜻해요. 룻은 옷을 덮어 달라는 말로 보아스에게 혼인과 친족으로서의 보호를 요청해요. 2:12에서 하나님의 날개 아래 피한다는 축복이 여기서 실제 책임을 청하는 말로 이어져요."}],"11":[{"he":"אֵשֶׁת חַיִל","rd":"에셰트 하일","m":"힘·능력·덕을 갖춘 여인","t":"재산, 능력, 용기, 훌륭함을 폭넓게 나타내는 말이에요. 여기서 보아스는 가난한 외국인 과부인 룻을 공동체가 인정하는 가치 있는 사람으로 불러요. 단지 얌전한 여성이라는 뜻으로 줄이면 룻의 행동력과 신실함을 놓쳐요."}],"15":[{"he":"שֵׁשׁ־שְׂעֹרִים","rd":"셰쉬 세오림","m":"보리 여섯 분량","t":"원문에는 ‘여섯’ 뒤에 부피 단위가 없어요. 그래서 여섯 에바나 여섯 스아처럼 단위를 보충해 몇 kg인지 계산할 수는 없어요. 마지막 동사는 기록된 히브리어 그대로 보아스가 성읍으로 갔다는 뜻이에요."}],"16":[{"he":"מִי־אַתְּ בִּתִּי","rd":"미 아트 비티","m":"너는 누구냐, 내 딸아","t":"글자 그대로는 ‘너는 누구냐’지만, 낯선 사람의 신원을 묻는다기보다 일이 어떻게 되었는지 확인하는 말로 읽어요. 나오미는 돌아온 이를 자기 딸이라고 부르며 보아스와의 일이 어떻게 진전됐는지 들어요."}]}},"4":{"t":"다시 이어지는 이름","sp":{"1":[[3,"보아스","더 가까운 친족","speech",""]],"2":[[1,"보아스","장로들","speech",""]],"3":[[1,"보아스","더 가까운 친족","speech",""]],"4":[[6,"더 가까운 친족","보아스","speech",""]],"5":[[1,"보아스","더 가까운 친족","speech",""]],"6":[[1,"더 가까운 친족","보아스","speech",""]],"8":[[1,"더 가까운 친족","보아스","speech",""]],"9":[[1,"보아스","장로들과 백성","speech",""]],"11":[[1,"백성과 장로들","보아스","speech",""]],"14":[[1,"여자들","나오미","speech",""]],"17":[[1,"이웃 여자들","","speech",""]]},"ln":{"1":[["bg-people-110","보아스","person"],["bg-things-060","성문","culture"]],"2":[["bg-people-110","보아스","person"],["bg-things-061","장로","culture"]],"3":[["bg-people-110","보아스","person"],["bg-places-025","모압","place"],["bg-people-104","나오미","person"],["bg-people-105","엘리멜렉","person"]],"4":[["bg-things-061","장로","culture"]],"5":[["bg-people-110","보아스","person"],["bg-people-104","나오미","person"],["bg-places-025","모압","place"],["bg-people-106","룻","person"]],"7":[["bg-people-025","이스라엘","person"]],"8":[["bg-people-110","보아스","person"]],"9":[["bg-people-110","보아스","person"],["bg-things-061","장로","culture"],["bg-people-105","엘리멜렉","person"],["bg-people-109","기룐","person"],["bg-people-108","말론","person"],["bg-people-104","나오미","person"]],"10":[["bg-people-108","말론","person"],["bg-places-025","모압","place"],["bg-people-106","룻","person"]],"11":[["bg-things-060","성문","culture"],["bg-things-061","장로","culture"],["bg-people-025","이스라엘","person"],["bg-people-026","라헬","person"],["bg-people-027","레아","person"],["bg-places-045","에브랏","place"],["bg-places-044","베들레헴","place"]],"12":[["bg-people-046","다말","person"],["bg-people-034","유다","person"],["bg-people-047","베레스","person"]],"13":[["bg-people-110","보아스","person"],["bg-people-106","룻","person"]],"14":[["bg-people-104","나오미","person"],["bg-people-025","이스라엘","person"]],"16":[["bg-people-104","나오미","person"]],"17":[["bg-people-104","나오미","person"],["bg-people-111","오벳","person"],["bg-people-112","이새","person"],["bg-people-113","다윗","person"]],"18":[["bg-people-047","베레스","person"],["bg-people-135","헤스론","person"]],"19":[["bg-people-135","헤스론","person"],["bg-people-136","람","person"]],"20":[["bg-people-133","나손","person"],["bg-people-137","살몬","person"]],"21":[["bg-people-137","살몬","person"],["bg-people-110","보아스","person"],["bg-people-111","오벳","person"]],"22":[["bg-people-111","오벳","person"],["bg-people-112","이새","person"],["bg-people-113","다윗","person"]]},"vn":{"1":[{"he":"פְּלֹנִי אַלְמֹנִי","rd":"펠로니 알모니","m":"아무개·그 사람","t":"히브리어는 이 친족의 실명을 밝히지 않고 ‘아무개’라고 불러요. 고유명사가 아니라서 이름의 뜻을 가진 새 인물로 읽으면 안 돼요. 죽은 이의 이름을 잇는 이야기에서 이 인물은 이름 없이 남는다는 문학적 효과가 있어요."}],"3":[{"he":"מָכְרָה","rd":"마크라","m":"팔았다·팔려고 내놓았다","t":"히브리어 형태는 완료형(‘팔았다’)이지만, 장면에서는 앞으로 정할 거래를 말하고 있어서 ‘팔려고 내놓았다’로 읽을 수 있어요. 이미 이뤄진 매매를 되찾는 과정으로 읽는 해석도 있어요. 본문은 나오미의 재산권에 관한 모든 법적 세부를 알려 주지는 않아요."}],"5":[{"he":"קָנִיתָ","rd":"카니타","m":"네가 취득한다(낭독형)","t":"이 절의 기록형(케티브)은 ‘내가 취득했다’, 전통 낭독형(케리)은 ‘네가 취득했다’로 전해져요. 낭독형과 4:10의 흐름을 따르면, 땅을 사는 사람이 룻을 아내로 맞아 죽은 이의 이름을 이어야 한다는 뜻이 돼요. 거래 언어의 역사적 배경을 현대의 보편적 인간 가치와 같다고 볼 수는 없어요."}],"7":[{"he":"שָׁלַף אִישׁ נַעֲלוֹ","rd":"샬라프 이쉬 나알로","m":"자기 신을 벗어 건넸다","t":"본문 자체가 이것을 예전 이스라엘의 거래 확인 관습이라고 설명해요. 권리를 넘긴다는 일을 눈에 보이는 행동으로 확정해요. 신명기 25장의 형제 혼인 거절 때 침 뱉는 의식과 완전히 같은 장면은 아니에요."}],"14":[{"he":"גֹּאֵל","rd":"고엘","m":"되찾아 주는 이·회복을 돕는 친족","t":"여기서는 바로 앞에서 태어난 아이와 다음 절의 양육·노년 돌봄을 함께 읽어야 해요. 2–3장의 보아스만을 가리킨다고 확정할 수는 없어요. 아이가 나오미의 생기를 되돌리고 가족의 앞날을 잇는 역할로 축복받아요."}],"17":[{"he":"יֻלַּד־בֵּן לְנָעֳמִי","rd":"율라드 벤 레나오미","m":"나오미에게 아들이 태어났다","t":"실제 아이를 낳은 사람은 룻이라고 4:13이 분명히 말해요. 이웃의 말은 나오미의 가족과 미래가 회복되었다는 기쁨을 표현해요. 나오미가 생물학적 어머니가 되었다거나 특정 입양 절차가 있었다고 읽을 수는 없어요."}]}}}
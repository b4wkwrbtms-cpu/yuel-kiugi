{"1":{"ln":{"2":[["king-dict-031","유다","place"],["ot-14-036-0064","하늘의 하나님","hebrew"]],"5":[["sam-dict-042","베냐민","place"],["bg-people-033","레위","person"]],"7":[["king2-dict-053","느부갓네살","person"],["ot-15-001-0065","고레스","person"]],"11":[["king2-dict-075","바빌론","place"],["ot-15-001-0067","세스바살","person"]],"1":[["ot-15-001-0065","고레스","person"],["ot-15-001-0066","마음을 움직이셨다","hebrew"]],"8":[["ot-15-001-0067","세스바살","person"],["ot-15-001-0065","고레스","person"]]},"vn":{"1":[{"he":"וּבִשְׁנַת אַחַת לְכוֹרֶשׁ","rd":"우비셰낫 아하트 러코레쉬","m":"원어 수정","fx":1,"krv":"고레스 원년에","gl":"고레스의 첫해에","was":"고레스가 왕이 된 첫해였다","now":"고레스의 첫해였다","t":"원어는 ‘고레스 첫해에’(שנת אחת לכורש)이고 ‘왕이 된’이라는 말은 없어요. 대하 36:22와 같은 구절이라 ‘고레스의 첫해’로 맞췄어요.","alt":[{"r":"고레스 원년에","g":"히브리어는 서수 대신 ‘하나’(אחת)를 써서 ‘원년’처럼 연대 표기로 읽을 수도 있어요.","by":"개역한글 ‘원년’"},{"r":"마음을 일깨우셨다","g":"동사 헤이르(עיר)는 ‘깨우다, 일으키다’ 뜻이 기본이라 ‘일깨우셨다’로 읽을 수 있어요.","by":"KJV·ESV·NASB·YLT(스 1:1 같은 표현)"}],"pick":"원어에 ‘왕이 된’이 없어 ‘고레스의 첫해’로, 마음 표현은 ‘움직이셨다’로 두었어요."}]},"t":"고레스의 선포와 돌아온 성전 그릇","q":"고레스는 바빌론에 가 있던 성전 그릇들을 어떻게 했을까요?","g":["역대하의 마지막 장에서 끝난 고레스의 선포가, 에스라의 첫 장에서 그대로 이어져요.","하나님이 마음을 움직이신 사람들이 일어나고, 성전 그릇이 세스바살에게 넘겨져요. 다음 장은 올라온 사람들의 명단이에요."],"one":"하나님이 마음을 움직이신 사람은 모두 일어났다.","sp":{"2":[[0,"고레스","온 나라","speech",""]]}},"2":{"ln":{"1":[["king2-dict-053","느부갓네살","person"],["king2-dict-075","바빌론","place"],["king-dict-031","유다","place"]],"6":[["sam-dict-011","요압","person"]],"16":[["king2-dict-032","히스기야","person"]],"21":[["bg-places-044","베들레헴","place"]],"26":[["bg-places-084","라마","place"]],"28":[["bg-places-001","벧엘","place"]],"34":[["bg-places-041","여리고","place"]],"40":[["bg-people-033","레위","person"]],"55":[["sam-dict-044","솔로몬","person"]],"61":[["sam-dict-024","바르실래","person"],["bg-places-028","길르앗","place"]],"63":[["ot-15-002-0068","우림과 둠밈","culture"]],"62":[["ot-16-007-2036","찾지 못했다","culture"]],"2":[["ot-15-003-0069","스룹바벨","person"],["ot-16-001-0085","느헤미야","person"],["ot-17-002-0117","모르드개","person"]],"23":[["ot-24-001-0577","아나돗","place"]]},"t":"돌아온 사람들의 명단","q":"고향으로 올라온 사람은 모두 몇 명이었을까요?","g":["앞 장에서 성전 그릇과 함께 출발한 사람들이, 이 장에서는 이름과 수로 하나하나 적혀요.","집안별, 성읍별로 센 뒤 제사장과 레위 사람 등을 따로 적고, 예물로 끝나요. 다음 장은 일곱째 달의 제단이에요."],"one":"온 회중을 다 합하면 42,360명이었다.","fold":[[2,35,"족보·인구·명단","스룹바벨과 함께 올라온 집안과 성읍",["스룹바벨, 예수아, 느헤미야 같은 지도자들이 먼저 나오고, 집안별 남자 수가 이어져요.","이어서 베들레헴, 아나돗, 여리고 같은 성읍 사람 수가 적혀요.","다음 부분은 제사장, 레위 사람, 노래하는 사람들이에요."],["연결","의미","다음"],"에스라2:2–2:35",0],[36,58,"족보·인구·명단","제사장과 성전을 섬기는 사람들",["제사장 네 집안, 레위 사람, 노래하는 사람, 문지기 자손이 차례로 나와요.","성전 막일꾼(느디님)과 솔로몬 신하들의 자손도 이름으로 적혀요.","다음에는 조상의 기록을 찾지 못한 사람들 이야기가 이어져요."],["연결","의미","다음"],"에스라2:36–2:58",0],[59,67,"족보·인구·명단","기록을 찾지 못한 사람들과 총수",["조상의 집안을 밝히지 못한 사람들과 제사장 가운데 기록이 없는 집안이 나와요.","총독은 우림과 둠밈을 다룰 제사장이 나설 때까지 가장 거룩한 음식을 먹지 말라고 해요.","온 회중의 합계와 종, 말, 낙타, 나귀 수로 끝나요."],["연결","의미","다음"],"에스라2:59–2:67",0]]},"3":{"ln":{"2":[["bg-people-053","모세","person"],["ot-15-003-0069","스룹바벨","person"]],"7":[["king-dict-044","레바논","place"],["king-dict-042","두로","place"],["king-dict-043","시돈","place"],["ot-15-001-0065","고레스","person"]],"8":[["bg-people-033","레위","person"],["ot-15-003-0069","스룹바벨","person"]],"9":[["king-dict-031","유다","place"]],"10":[["sam-dict-043","다윗","person"],["ot-14-029-0050","심벌즈","culture"]],"3":[["ot-15-003-0070","원래 있던 터","culture"]],"12":[["ot-15-003-0071","큰 소리로 울었다","hebrew"]]},"t":"제단을 세우고 기초를 놓다","q":"기초가 놓이던 날, 어떤 이는 울고 어떤 이는 소리친 건 왜일까요?","g":["명단 뒤에 일곱째 달이 되어, 모든 백성이 예루살렘에 모여 제단부터 세워요.","성전 기초가 놓이는 날에 함성과 울음이 한꺼번에 터져요. 다음 장은 주변 사람들의 방해예요."],"one":"백성은 기뻐 지르는 함성과 백성이 우는 소리를 구별할 수 없었다.","sp":{"11":[[1,"찬양하는 사람들","여호와","prayer",""]]}},"4":{"ln":{"1":[["sam-dict-042","베냐민","place"],["king-dict-031","유다","place"]],"2":[["king2-dict-073","아시리아","place"],["ot-15-004-0072","함께 짓게 해 주십시오","hebrew"],["ot-15-003-0069","스룹바벨","person"]],"7":[["king2-dict-062","아람","place"],["ot-15-004-0073","아닥사스다","person"],["ot-15-004-0074","아람 글자","hebrew"]],"9":[["king2-dict-075","바빌론","place"]],"10":[["king-dict-032","사마리아","place"]],"6":[["ot-17-001-0114","아하수에로","person"]],"3":[["ot-15-001-0065","고레스","person"],["ot-15-003-0069","스룹바벨","person"]],"5":[["ot-15-001-0065","고레스","person"]],"8":[["ot-15-004-0073","아닥사스다","person"]],"11":[["ot-15-004-0073","아닥사스다","person"]],"23":[["ot-15-004-0073","아닥사스다","person"]]},"t":"방해와 멈춰 선 공사","q":"함께 짓자는 제안에 스룹바벨은 뭐라고 대답했을까요?","g":["기초를 놓은 사람들에게 그 땅의 사람들이 찾아와요. 거절당하자 공사를 방해해요.","고레스부터 아닥사스다까지 여러 왕 때의 고발이 이어지고, 편지는 아람 말로 옮겨져요. 다음 장은 학개와 스가랴가 예언하는 이야기예요."],"one":"그렇게 예루살렘에 있는 하나님의 성전 공사가 멈췄다.","sp":{"2":[[1,"그 땅 사람들","스룹바벨과 집안 우두머리들","speech",""]],"3":[[1,"스룹바벨과 예수아와 집안 우두머리들","그 땅 사람들","speech",""]],"11":[[1,"르훔과 심새와 동료들","아닥사스다 왕","speech",""]],"17":[[1,"아닥사스다 왕","르훔과 심새","speech",""]]}},"5":{"ln":{"1":[["king-dict-031","유다","place"],["ot-15-005-0075","학개","person"]],"12":[["king2-dict-053","느부갓네살","person"],["king2-dict-075","바빌론","place"],["king2-dict-081","갈대아","place"]],"14":[["ot-15-001-0067","세스바살","person"],["ot-15-001-0065","고레스","person"]],"16":[["ot-15-001-0067","세스바살","person"]],"13":[["ot-15-001-0065","고레스","person"]],"17":[["ot-15-001-0065","고레스","person"]],"2":[["ot-15-003-0069","스룹바벨","person"]]},"t":"총독의 물음과 다리오에게 올린 보고","q":"총독이 누가 허락했느냐고 물었을 때, 장로들은 뭐라고 답했을까요?","g":["멈춰 있던 공사가 예언자 학개와 스가랴의 말로 다시 시작돼요.","총독 닷드내가 물으러 오고, 다리오 왕에게 보고서를 올려요. 다음 장은 그 답장이에요."],"one":"하지만 하나님의 눈이 유대 장로들 위에 있었다.","sp":{"3":[[1,"닷드내와 스달보스내와 동료들","유대 장로들","speech",""]],"7":[[1,"닷드내와 스달보스내","다리오 왕","speech",""]]}},"6":{"ln":{"1":[["king2-dict-075","바빌론","place"]],"5":[["king2-dict-053","느부갓네살","person"]],"16":[["bg-people-033","레위","person"]],"18":[["bg-people-053","모세","person"]],"22":[["king2-dict-073","아시리아","place"],["ot-15-006-2034","아시리아 왕의 마음","thing"]],"14":[["ot-15-005-0075","학개","person"],["ot-15-001-0065","고레스","person"],["ot-15-004-0073","아닥사스다","person"]],"11":[["ot-15-006-2033","들보를 뽑아 세우고","culture"]],"3":[["ot-15-001-0065","고레스","person"]],"2":[["ot-23-013-0481","메디아","place"]]},"t":"다리오의 명령과 성전 봉헌","q":"바빌론 문서고를 뒤진 다리오는 무엇을 찾았을까요?","g":["앞 장의 보고서를 받은 다리오 왕이 문서고를 뒤지게 해요. 메디아의 성채에서 고레스의 비망록이 나와요.","다리오는 방해를 멈추고 비용을 대라고 명령하고, 성전이 완성되어 봉헌돼요. 다음 장은 오랜 뒤 에스라가 등장하는 이야기예요."],"one":"유대 장로들은 예언자 학개와 잇도의 자손 스가랴가 전한 예언에 힘입어 성전을 지었고, 공사는 척척 이루어졌다.","sp":{"3":[[0,"고레스","","reported",""]],"6":[[0,"다리오","닷드내와 스달보스내","speech",""]]}},"7":{"ln":{"1":[["king2-dict-103","스라야","person"],["ot-15-004-0073","아닥사스다","person"],["ot-15-007-0076","에스라","person"]],"5":[["bg-people-062","엘르아살","person"],["bg-people-076","비느하스","person"],["bg-people-054","아론","person"]],"6":[["king2-dict-075","바빌론","place"],["bg-people-053","모세","person"],["ot-15-007-0077","율법학자","hebrew"],["ot-15-007-0076","에스라","person"]],"7":[["bg-people-033","레위","person"]],"14":[["king-dict-031","유다","place"]],"12":[["ot-14-036-0064","하늘의 하나님","hebrew"],["ot-15-007-0077","율법학자","hebrew"],["ot-15-007-0076","에스라","person"]],"9":[["ot-15-007-0078","선한 손","hebrew"]],"10":[["ot-15-007-0079","마음을 굳혔던","hebrew"],["ot-15-007-0076","에스라","person"],["ot-19-019-0209","여호와의 율법","hebrew"]],"11":[["ot-15-007-0076","에스라","person"]],"21":[["ot-15-007-0076","에스라","person"]],"25":[["ot-15-007-0076","에스라","person"]]},"vn":{"4":[{"he":"עֻזִּי","rd":"웃시","m":"원어 수정","fx":1,"krv":"웃시엘의 십 일대손이요","gl":"웃시(사람 이름)","was":"스라히야는 웃시엘의 아들, 웃시엘은 북기의 아들","now":"스라히야는 웃시의 아들, 웃시는 북기의 아들","t":"원어는 웃시엘(עֻזִּיאֵל)이 아니라 עֻזִּי(웃시)예요. 같은 계보인 대상 6:5는 ‘웃시’로 옮겨서 맞췄어요.","alt":[],"pick":"원어에는 웃시엘이 아닌 웃시로 적혀 있어 다른 읽기의 여지가 거의 없어요"}]},"t":"율법학자 에스라와 왕의 편지","q":"아닥사스다 왕은 에스라에게 어떤 권한을 맡겼을까요?","g":["성전이 봉헌되고 한참 뒤, 아닥사스다 왕 때 율법학자 에스라가 바빌론에서 올라와요.","왕의 편지가 은과 금, 세금 면제, 재판관을 세우는 권한까지 적고 있어요. 다음 장은 에스라와 함께 올라온 사람들의 명단이에요."],"one":"그의 하나님 여호와의 손이 그와 함께하셨기 때문에, 왕은 그가 구하는 것을 다 들어주었다.","sp":{"12":[[0,"아닥사스다 왕","에스라","speech",""]]}},"8":{"ln":{"1":[["king2-dict-075","바빌론","place"]],"2":[["bg-people-063","이다말","person"],["sam-dict-043","다윗","person"]],"9":[["sam-dict-011","요압","person"]],"15":[["bg-people-033","레위","person"]],"27":[["ot-13-029-0020","다릭","culture"]],"18":[["ot-15-007-0078","선한 손","hebrew"]],"21":[["ot-15-008-0080","금식을 선포했다","culture"]],"16":[["ot-23-029-0502","아리엘","place"]],"8":[["ot-27-010-0762","미가엘","hebrew"]]},"t":"에스라와 함께 올라온 사람들","q":"레위 사람이 한 사람도 안 보이자 에스라는 어떻게 했을까요?","g":["앞 장의 편지를 받은 에스라가 집안별로 사람을 모아요. 이 장은 '나'라는 에스라의 입으로 적혀 있어요.","아하와강 가에서 레위 사람을 부르고 금식하며 길을 구해요. 다음 장은 예루살렘에서 듣게 되는 소식이에요."],"one":"하나님은 우리 간구를 들어주셨다.","sp":{"22":[[2,"에스라 일행","왕","reported",""]],"28":[[1,"에스라","제사장 지도자 열두 명","speech",""]]},"fold":[[2,14,"족보·인구·명단","에스라와 함께 올라온 집안 우두머리들",["비느하스, 이다말, 다윗 집안에서 시작해 집안마다 우두머리 이름과 남자 수가 적혀요.","바로스, 바핫모압, 아딘, 엘람 같은 집안이 이어져요.","다음에는 아하와강에서 레위 사람을 찾는 이야기가 나와요."],["연결","의미","다음"],"에스라8:2–8:14",0]]},"9":{"ln":{"1":[["bg-places-023","가나안","place"],["bg-places-046","여부스","place"],["bg-places-024","이집트","place"],["bg-places-025","모압","place"],["bg-people-033","레위","person"],["bg-places-026","암몬","place"]],"9":[["king-dict-031","유다","place"]],"2":[["ot-15-009-0081","거룩한 씨","hebrew"],["ot-15-009-0082","배신","hebrew"]],"8":[["ot-15-009-0083","말뚝 하나","hebrew"]],"4":[["ot-15-009-0082","배신","hebrew"],["ot-19-141-0367","저녁 곡식 제사","culture"]],"5":[["ot-19-141-0367","저녁 곡식 제사","culture"]]},"t":"섞여 버린 거룩한 씨와 에스라의 기도","q":"지도자들의 말을 들은 에스라는 어떻게 했을까요?","g":["예루살렘에 도착해 일을 마친 에스라에게 지도자들이 찾아와 이방 사람과의 결혼을 알려요.","옷을 찢고 주저앉은 에스라가 저녁 제사 때 일어나 기도해요. 다음 장은 그 기도 곁에 모인 백성의 이야기예요."],"one":"그래도 저희 하나님은 저희 죄악보다 가볍게 벌하셨고, 이렇게 살아남은 사람들을 저희에게 주셨어요.","sp":{"1":[[1,"지도자들","에스라","speech",""]],"6":[[1,"에스라","하나님","prayer",""]]}},"10":{"ln":{"5":[["bg-people-033","레위","person"],["ot-15-007-0076","에스라","person"]],"7":[["king-dict-031","유다","place"]],"9":[["sam-dict-042","베냐민","place"]],"30":[["bg-people-044","므낫세","person"]],"40":[["bg-people-017","사래","person"]],"3":[["ot-15-010-0084","내보내기로","hebrew"]],"1":[["ot-15-007-0076","에스라","person"]],"2":[["ot-15-007-0076","에스라","person"]],"6":[["ot-15-007-0076","에스라","person"],["ot-15-009-0082","배신","hebrew"]],"10":[["ot-15-007-0076","에스라","person"]],"16":[["ot-15-007-0076","에스라","person"]]},"vn":{"2":[{"he":"אֲנַחְנוּ מָעַלְנוּ בֵאלֹהֵינוּ","rd":"아납누 마알누 벨로헤누","m":"원어 수정","fx":1,"krv":"우리가 우리 하나님께 범죄하여","gl":"우리가 우리 하나님께 신의를 저버렸다","was":"저희 하나님을 배신했습니다","now":"저희 하나님께 신의를 저버렸습니다","t":"원어는 마알(신의를 저버리다) 동사예요. ‘배신했다’도 뜻은 통하지만 같은 동사를 ‘신의를 저버리다’로 옮긴 다른 절과 맞췄어요.","alt":[{"r":"저희 하나님께 범죄했습니다","g":"מעל를 ‘범죄하다’로 넓게 옮기는 것도 가능해요.","by":""}],"pick":"다른 절에서 מעל를 ‘신의를 저버리다’로 옮긴 것과 맞췄어요."}]},"t":"이방 아내를 내보내기로 한 백성","q":"에스라가 울며 기도할 때 먼저 말을 꺼낸 사람은 누구였을까요?","g":["기도하며 우는 에스라 곁에 큰 무리가 모여들어요. 엘람 자손 스가냐가 먼저 나서요.","비 오는 날 온 백성이 모여 맹세하고, 이방 여자를 아내로 맞은 사람들이 이름으로 적혀요. 다음 책 느헤미야는 이 사람들이 사는 예루살렘의 성벽 이야기예요."],"one":"이들은 모두 이방 여자를 아내로 맞은 사람들이다.","sp":{"2":[[1,"스가냐","에스라","speech",""]],"10":[[1,"에스라","백성","speech",""]],"12":[[1,"온 회중","에스라","speech",""]]},"fold":[[18,43,"족보·인구·명단","이방 여자를 아내로 맞은 사람들",["제사장 집안에서 시작해 레위 사람, 노래하는 사람, 문지기가 차례로 적혀요.","이어서 바로스, 엘람, 삿두, 바니 같은 일반 이스라엘 집안 사람들이 이름으로 나와요.","명단이 끝나고 마지막 한 절이 전체를 요약해요."],["연결","의미","다음"],"에스라10:18–10:43",0]]}}
{"1":{"vn":{"1":[{"he":"","rd":"","m":"사본 차이","t":"‘하나님의 아들’ — 오래된 사본 일부에는 없어요(NA28 괄호)."}],"41":[{"he":"","rd":"","m":"사본 차이","t":"‘불쌍히 여기셔서’ — 일부 오래된 사본에는 ‘화가 나셔서’로 되어 있어요."}],"10":[{"he":"σχιζομένους τοὺς οὐρανοὺς","rd":"스키조메누스 투스 우라누스","m":"원어 수정","fx":1,"krv":"하늘이 갈라짐","gl":"찢어지는(갈라져 열리는) 하늘","was":"하늘이 갈라지고","now":"하늘이 찢어지고","t":"σχίζω는 ‘찢다’가 기본 뜻이고 현재 분사라 하늘이 찢어지는 중이에요. 마가가 15:38 성전 휘장에도 같은 동사를 써서 책의 처음과 끝이 이어지므로 개역의 ‘갈라짐’을 ‘찢어지고’로 고쳤어요.","alt":[{"r":"하늘이 갈라져 열리고","g":"σχίζω는 ‘쪼개다·갈라지게 하다’로도 쓰이고, 마태 3:16과 누가 3:21은 ‘열리다’(ἀνοίγω)를 써요.","by":""}],"pick":"마가가 1:10과 15:38에 같은 동사를 써서 처음과 끝을 잇는 만큼 ‘찢어지다’로 맞췄어요."}]},"ln":{"2":[["king2-dict-037","이사야","person"]],"5":[["bg-places-040","요단강","place"],["nt-40-03-0016","세례","hebrew"],["nt-45-06-0714","세례","culture"]],"9":[["king2-dict-098","갈릴리","place"],["nt-40-02-0012","나사렛","place"],["nt-40-03-0016","세례","hebrew"],["nt-45-06-0714","세례","culture"]],"44":[["bg-people-053","모세","person"]],"24":[["nt-40-02-0012","나사렛","place"]],"21":[["nt-40-04-0025","회당","culture"],["nt-40-04-0022","가버나움","place"]],"1":[["nt-40-04-0026","복음","hebrew"],["nt-41-08-0250","그리스도(메시아)","hebrew"]],"14":[["nt-40-04-0026","복음","hebrew"]],"15":[["nt-41-01-0217","하나님 나라가 가까이 왔다","hebrew"],["nt-40-04-0026","복음","hebrew"]],"22":[["nt-41-01-0219","권위 있는","hebrew"]],"34":[["nt-41-01-0220","말하지 못하게 하셨다","hebrew"],["nt-46-10-0834","귀신들","hebrew"]],"11":[["nt-40-03-0019","사랑하는 아들","hebrew"]],"4":[["nt-40-03-0016","세례","hebrew"],["nt-45-06-0714","세례","culture"]],"8":[["nt-40-03-0016","세례","hebrew"],["nt-45-06-0714","세례","culture"]],"17":[["nt-40-04-0024","사람을 낚는 어부","culture"]],"23":[["nt-40-04-0025","회당","culture"]],"29":[["nt-40-04-0025","회당","culture"],["nt-44-15-0617","야고보","person"]],"39":[["nt-40-04-0025","회당","culture"],["nt-46-10-0834","귀신들","hebrew"]],"19":[["nt-44-15-0617","야고보","person"]]},"t":"광야의 소리와 첫 제자들","q":"더러운 귀신은 회당에서 예수님을 뭐라고 불렀을까요?","g":["마가복음의 첫 장이에요. 요한의 세례와 광야의 시험이 짧게 지나가고, 예수님이 갈릴리에서 선포를 시작하세요.","첫 제자 네 사람을 부르시고, 가버나움에서 귀신과 병을 물리치세요. 다음 장은 지붕을 뚫고 내려온 중풍병자 이야기예요."],"one":"다른 데로 가자. 가까운 마을들로. 거기서도 내가 선포해야 한다. 나는 그러려고 나왔다.","sp":{"7":[[1,"요한","사람들","speech",""]],"11":[[1,"하늘에서 난 소리","예수님","speech",""]],"15":[[0,"예수님","","speech",""]],"17":[[1,"예수님","시몬과 안드레","speech",""]],"24":[[0,"더러운 귀신","예수님","speech",""]],"25":[[1,"예수님","더러운 귀신","speech",""]],"27":[[1,"사람들","서로","speech",""]],"37":[[1,"시몬과 그 일행","예수님","speech",""]],"38":[[1,"예수님","시몬과 그 일행","speech",""]],"40":[[1,"악성 피부병에 걸린 사람","예수님","speech",""]],"41":[[1,"예수님","그 사람","speech",""]],"44":[[0,"예수님","그 사람","speech",""]]}},"3":{"vn":{"32":[{"he":"","rd":"","m":"사본 차이","t":"‘누이들’ — 오래된 사본 일부에는 없어요(NA28 괄호)."}],"18":[{"he":"Καναναῖον","rd":"카나나이온","m":"원어 수정","fx":1,"krv":"가나안인 시몬","gl":"열심당원(열심 있는 사람)","was":"가나안인 시몬,","now":"열심당원 시몬,","t":"원어 Καναναῖος(카나나이오스)는 가나안을 뜻하는 Χαναναία(마 15:22)와 철자가 달라요. 아람어 ‘열심 있는 사람’(카나나)에서 온 말로, 눅 6:15·행 1:13이 같은 시몬을 Ζηλωτής(열심당원)로 부르는 것과 맞춰 ‘열심당원’으로 고쳤어요. 개역한글은 ‘가나안인’이에요.","alt":[{"r":"가나안 사람 시몬(출신 지명으로 읽음)","g":"형태가 Καναναῖος라서 ‘가나안 사람’ 또는 갈릴리 가나 마을 출신으로 읽는 길도 열려 있어요.","by":"KJV"}],"pick":"같은 시몬을 눅 6:15·행 1:13이 Ζηλωτής로 부르고 있고, 가나안 사람은 철자가 다른 Χαναναῖος로 쓰여서 별명(열심당원)으로 읽었어요."}]},"ln":{"7":[["king2-dict-098","갈릴리","place"]],"8":[["bg-places-040","요단강","place"],["king-dict-042","두로","place"],["king-dict-043","시돈","place"]],"6":[["nt-40-03-0017","바리새파","culture"]],"1":[["nt-40-04-0025","회당","culture"]],"18":[["nt-40-09-0062","마태","person"],["nt-44-15-0617","야고보","person"]],"29":[["nt-41-03-0228","성령을 모독하는","hebrew"]],"11":[["nt-41-15-0282","하나님의 아들","hebrew"]],"17":[["nt-44-15-0617","야고보","person"]],"22":[["nt-46-10-0834","귀신들","hebrew"]]},"t":"열두 사람과 예수님의 가족","q":"예수님은 '누가 내 어머니고 내 형제들이냐'고 물으신 뒤 누구를 가리키실까요?","g":["앞 장의 안식일 논쟁이 이어져, 회당에서 오그라든 손을 고치시고 바리새파 사람들이 없앨 방법을 의논해요.","바닷가의 무리와 열두 사람을 세우는 일을 지나, 가족과 율법학자들의 오해 속에 새 가족을 말씀하세요."],"one":"누구든지 하나님의 뜻대로 사는 사람, 그 사람이 내 형제고, 자매고, 어머니다.","sp":{"3":[[1,"예수님","손이 오그라든 사람","speech",""]],"4":[[1,"예수님","사람들","speech",""]],"5":[[3,"예수님","손이 오그라든 사람","speech",""]],"11":[[1,"더러운 귀신들","예수님","speech",""]],"22":[[1,"예루살렘에서 내려온 율법학자들","","speech",""]],"23":[[1,"예수님","율법학자들","speech",""]],"32":[[2,"사람들","예수님","speech",""]],"33":[[1,"예수님","사람들","speech",""]],"34":[[1,"예수님","둘러앉은 사람들","speech",""]]}},"7":{"vn":{"16":[{"he":"","rd":"","m":"사본 차이","t":"이 절은 표준판(NA28)에 없어요. 개역의 이 절 내용은 15절 뒷부분과 같고, 일부 사본에만 ‘들을 귀 있는 자는 들으라’는 절이 따로 있어요."}],"12":[{"he":"οὐκέτι ἀφίετε αὐτὸν οὐδὲν ποιῆσαι","rd":"우케티 아피에테 아우톤 우덴 포이에사이","m":"원어 수정","fx":1,"krv":"허하지 아니하여","gl":"너희는 더는 그가 아무것도 하게 허락하지 않는다","was":"그 사람이 아버지나 어머니에게 더는 아무것도 해 드리지 못하게 한다","now":"너희는 그 사람이 아버지나 어머니에게 더는 아무것도 해 드리는 걸 허락하지 않는다","t":"ἀφίετε는 2인칭 복수라 주어가 ‘너희’(전통을 가르치는 사람들)이고 뜻은 ‘허락하다·그냥 두다’예요. 지금 줄은 주어가 없어 그 사람이 스스로 못 하는 것처럼 읽혀서 ‘너희는 … 허락하지 않는다’로 고쳤어요.","alt":[{"r":"너희는 그 사람이 … 해 드리지 못하게 놔둔다","g":"ἀφίημι는 ‘허락하다·내버려 두다’라서 ‘막는다’보다 ‘못하게 놔두다’에 가까운 읽기도 가능해요.","by":""}],"pick":"개역의 ‘허하지 아니하여’와 같은 ‘허락하지 않는다’에 주어 ‘너희’를 밝혔어요."}],"19":[{"he":"καθαρίζων πάντα τὰ βρώματα","rd":"카타리존 판타 타 브로마타","m":"원어 해석","ix":1,"gl":"모든 음식을 깨끗하게 하면서(깨끗하다고 선언하면서)","krv":"모든 식물을 깨끗하다 하셨느니라","now":"이렇게 예수님은 모든 음식이 깨끗하다고 하셨다","alt":[{"r":"이렇게 해서 예수님은 모든 음식을 깨끗하게 하신 거다","g":"καθαρίζων은 현재 분사로 ‘깨끗하게 하면서’이고 예수님의 직접 말이 아니라 마가의 해설로 읽을 수 있어요.","by":""}],"pick":"‘깨끗하다고 선언하셨다’는 흐름을 살려 개역과 같은 뜻으로 뒀어요.","t":""}],"27":[{"he":"τοῖς κυναρίοις","rd":"토이스 퀴나리오이스","m":"원어 해석","ix":1,"gl":"작은 개들(집 안의 개들)","krv":"개들","now":"개들한테","alt":[{"r":"강아지들한테","g":"κυνάριον은 κύων의 지소형이라 ‘작은 개’로 읽을 수 있고 7:28에서도 같은 지소형이 되풀이돼요.","by":""}],"pick":"지소형의 뜻이 어조를 부드럽게 하는지 분명하지 않아 개역과 같은 ‘개들’로 뒀어요.","t":""}]},"ln":{"6":[["king2-dict-037","이사야","person"]],"10":[["bg-people-053","모세","person"]],"24":[["king-dict-042","두로","place"]],"31":[["king2-dict-098","갈릴리","place"],["king-dict-043","시돈","place"]],"1":[["nt-40-03-0017","바리새파","culture"]],"3":[["nt-40-15-0106","장로들의 전통","hebrew"],["nt-40-03-0017","바리새파","culture"],["nt-63-01-1250","장로","hebrew"]],"11":[["nt-41-07-0243","고르반","hebrew"]],"19":[["nt-41-07-0244","모든 음식이 깨끗하다고","hebrew"]],"27":[["nt-41-07-0246","개들","hebrew"]],"28":[["nt-41-07-0246","개들","hebrew"]],"5":[["nt-40-03-0017","바리새파","culture"],["nt-63-01-1250","장로","hebrew"]],"13":[["nt-66-19-1114","하나님의 말씀","hebrew"]]},"t":"씻지 않은 손과 수로보니게 여자","q":"'개들한테 던져 주는 건 옳지 않다'는 말을 들은 두로의 여자는 뭐라고 답했을까요?","g":["앞 장 끝에서 게네사렛의 병든 사람들이 예수님께 몰려와요. 이 장은 예루살렘에서 온 바리새파 사람들이 씻지 않은 손을 따지는 데서 시작해요.","무엇이 사람을 더럽히는지 말씀하시고, 두로에서 이방 여자의 딸을 고치고, 데가볼리에서 듣지 못하는 사람의 귀를 여세요."],"one":"듣지 못하는 사람도 듣게 하고, 말 못 하는 사람도 말하게 하시네!","sp":{"5":[[1,"바리새파 사람들과 율법학자들","예수님","speech",""]],"6":[[1,"예수님","바리새파 사람들과 율법학자들","speech",""]],"9":[[1,"예수님","바리새파 사람들과 율법학자들","speech",""]],"14":[[1,"예수님","군중","speech",""]],"18":[[1,"예수님","제자들","speech",""]],"20":[[1,"예수님","제자들","speech",""]],"27":[[1,"예수님","수로보니게 여자","speech",""]],"28":[[1,"수로보니게 여자","예수님","speech",""]],"29":[[1,"예수님","수로보니게 여자","speech",""]],"34":[[1,"예수님","듣지 못하는 사람","speech",""]],"37":[[1,"사람들","","speech",""]]}},"10":{"vn":{"2":[{"he":"","rd":"","m":"사본 차이","t":"‘바리새파 사람들이 다가와’ — 오래된 사본 일부에는 없어요(NA28 괄호)."}],"17":[{"he":"ζωὴν αἰώνιον κληρονομήσω","rd":"조엔 아이오니온 클레로노메소","m":"원어 수정","fx":1,"krv":"영생을 얻으리이까","gl":"영원한 생명을 물려받다(상속하다)","was":"영원한 생명을 받을 수 있어요","now":"영원한 생명을 물려받을 수 있어요","t":"κληρονομέω는 ‘상속받다·물려받다’가 기본 뜻이고, 누가복음 10:25·18:18의 같은 동사는 이미 ‘물려받다’로 옮겨 있어서 마가도 맞췄어요.","alt":[{"r":"영원한 생명을 얻을 수 있어요","g":"κληρονομέω는 ‘얻다·차지하다’ 뜻으로도 쓰여요.","by":"개역한글"}],"pick":"기본 뜻 ‘물려받다’를 살리고 누가의 같은 낱말과 맞췄어요."}],"25":[{"he":"διελθεῖν","rd":"디엘테인","m":"원어 수정","fx":1,"krv":"바늘귀로 나가는 것이","gl":"지나가다(통과하다)","was":"바늘귀로 빠져나가는 게","now":"바늘귀로 지나가는 게","t":"διελθεῖν은 διέρχομαι의 부정사로 ‘통과해 지나가다’예요. ‘빠져나가다’는 나오는 쪽의 느낌이 있고, 마태 19:24 본문은 같은 그림을 ‘지나가는’으로 옮겨서 맞췄어요.","alt":[{"r":"바늘귀로 빠져나가는 게","g":"διέρχομαι는 ‘~을 통과하다’ 뜻이라 ‘빠져나가다’도 가능해요.","by":""}],"pick":"‘통과해 지나가다’라는 기본 뜻과 마태의 옮김에 맞췄어요."}],"40":[{"he":"οὐκ ἔστιν ἐμὸν δοῦναι","rd":"우크 에스틴 에몬 두나이","m":"원어 수정","fx":1,"krv":"나의 줄 것이 아니라","gl":"내가 줄 것이 아니다","was":"내가 정해 줄 수 있는 게","now":"내가 줄 수 있는 게","t":"δοῦναι는 δίδωμι의 부정사로 그냥 ‘주다’예요. ‘정해 주다’는 풀이가 들어가 ‘정할 권한’ 이야기처럼 읽혀서 ‘줄 수 있는’으로 고쳤어요. 마